# URL pública del sitio. Solo se usa para construir las URLs absolutas de Open Graph:
# los rastreadores de enlaces (Slack, WhatsApp, X, LinkedIn) ignoran las rutas relativas,
# así que `og:image` y `og:url` tienen que llevar el dominio completo.
#
# El valor por defecto vive en `.env.production` y es un MARCADOR DE POSICIÓN: hay que
# cambiarlo al dominio real la primera vez que se despliegue.
VITE_SITE_URL=https://cryptosh1f.pages.dev
